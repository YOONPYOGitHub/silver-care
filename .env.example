# Shareable template: fill blank connection values in the private .env.
# Do not put account names, credentials or cloud resource identifiers here.
# Setup and local execution: docs/operations.md

# AI Hub downloads; account fields are for manual login only.
AIHUB_ID=
AIHUB_PASSWORD=
AIHUB_API_KEY=

# Public Data Portal account fields are for manual login only.
DATA_GO_KR_ID=
DATA_GO_KR_PASSWORD=

# Collection-time welfare and institution API snapshots.
WELFARE_CENTRAL_API_KEY=
WELFARE_CENTRAL_API_ENDPOINT=
WELFARE_LOCAL_API_KEY=
WELFARE_LOCAL_API_ENDPOINT=
NHIS_LTC_SEARCH_API_KEY=
NHIS_LTC_SEARCH_API_ENDPOINT=
NHIS_LTC_DETAIL_API_KEY=
NHIS_LTC_DETAIL_API_ENDPOINT=

# Runtime official-health API. Keep the token on the server.
# Use KDCA_HEALTH_API_KEY or omit it and use NHIS_HEALTH_INFO_API_KEY.
KDCA_HEALTH_API_KEY=

# Azure connections use local az login or workload identity, not API keys.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
AZURE_SEARCH_CASE_INDEX=
AZURE_EMBEDDING_DEPLOYMENT=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_RESOURCE_ID=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=

# Non-sensitive development defaults. Set hybrid after configuring embeddings.
APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8000
RETRIEVAL_MODE=keyword
EMBEDDING_DIMENSIONS=512
REWRITE_QUERIES=false
SEMANTIC_RANKING=false
PREFER_OFFICIAL_REFERENCES=false
NONCOMMERCIAL_DATA_USE=false
CONTEXTUAL_RETRIEVAL=false
RATE_LIMIT_PER_MINUTE=12
MAX_CONCURRENT_REQUESTS=4
TRUSTED_PROXY=false
